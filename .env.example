# Copy to .env and adjust. Never commit .env.

# LLM used by the agent (LiteLLM model id). Default: local Ollama.
MODEL_ID=ollama_chat/qwen3:8b
OLLAMA_API_BASE=http://localhost:11434

# Optional cloud model keys, only needed if MODEL_ID points to a cloud provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
